{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run server.ts",
    "build": "vite build && esbuild ./server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild ./scripts/db-init.ts ./scripts/db-check.ts ./scripts/wait-for-db.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outdir=dist/cli --out-extension:.js=.cjs && bun run scripts/sync-migrations.ts",
    "start": "bun dist/server.cjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:init": "bun run scripts/db-init.ts",
    "db:seed:dev": "bun run scripts/dev-seed-users.ts",
    "db:seed:auth": "bun run scripts/seed-auth-accounts.ts",
    "db:doctor:auth": "bun run scripts/auth-doctor.ts",
    "db:check": "bun run scripts/db-check.ts",
    "db:wait": "bun run scripts/wait-for-db.ts",
    "db:legacy:list": "bun run scripts/db-legacy-list.ts",
    "db:import:sqlite": "bun run scripts/db-import-sqlite.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  }
}
