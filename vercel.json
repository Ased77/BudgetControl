{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build && node scripts/vercel-static.mjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/handler?__original=api/:path*"
    },
    {
      "source": "/dev/:path*",
      "destination": "/api/handler?__original=dev/:path*"
    },
    {
      "source": "/:path((?!api/|dev/|assets/|fonts/|index\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
